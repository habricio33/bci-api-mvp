# ==========================================
# Configurações do Banco de Dados PostgreSQL/PostGIS (BCI)
# ==========================================
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bci_cadastro
DB_USERNAME=postgres
DB_PASSWORD=postgres

DB_EXTERNAL_PORT=5436

# ==========================================
# Portas dos Serviços Docker
# ==========================================
APP_PORT=8086
PGADMIN_PORT=5056

# ==========================================
# Credenciais do pgAdmin 4
# ==========================================
PGADMIN_EMAIL=admin@bci.com
PGADMIN_PASSWORD=admin123

# ==========================================
# Configurações do GeoServer (WFS-T / WMS)
# ==========================================
GEOSERVER_PORT=8606
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver

# ==========================================
# Integração com a API do Sistema Tributário
# ==========================================
TRIBUTARIO_API_BASE_URL=https://gpi.domingosmartins.es.gov.br/tributario-api-rest/api/rest/v1/recadastramento-imobiliario
TRIBUTARIO_API_USER=seu_usuario
TRIBUTARIO_API_PASS=sua_senha

